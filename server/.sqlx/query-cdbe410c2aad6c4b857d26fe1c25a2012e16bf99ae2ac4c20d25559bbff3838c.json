{
  "db_name": "PostgreSQL",
  "query": "SELECT p.session_id, p.endpoint, p.p256dh, p.auth\n         FROM push_subscriptions p JOIN sessions s ON s.id = p.session_id\n         WHERE s.user_id = $1 AND s.expires_at > now()\n         ORDER BY p.created_at, p.session_id",
